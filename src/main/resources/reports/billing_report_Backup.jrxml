<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
  xmlns="http://jasperreports.sourceforge.net/jasperreports"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
  name="analysis_report"
  pageWidth="595" pageHeight="842"
  columnWidth="515"
  leftMargin="40" rightMargin="40"
  topMargin="50" bottomMargin="50"
  language="java">

  <!-- Parámetros que usarás desde tu servicio -->
  <parameter name="total" class="java.lang.Double"/>
  <parameter name="healthInsurance" class="java.lang.String"/>


  <!-- Campos de cada AnalysisPractice -->
  <field name="patientName"     class="java.lang.String"/>
  <field name="patientHealthInsurancePersonalId"     class="java.lang.String"/>
  <field name="realizationDate"   class="java.time.LocalDate"/>
  <field name="practiceCodesCsv" class="java.lang.String"/>
  <field name="subTotal"     class="java.lang.Double"/>

  <!-- 1) Encabezado del reporte (una sola vez al inicio) -->
  <title>
    <band height="60">
      <staticText>
        <reportElement x="0" y="0" width="515" height="20"/>
        <textElement textAlignment="Center">
          <font size="16" isBold="true"/>
        </textElement>
        <text><![CDATA[Reporte de Análisis Clínico]]></text>
      </staticText>
      <line>
        <reportElement x="0" y="20" width="500" height="1"/>
      </line>
      <textField>
        <reportElement x="0" y="25" width="300" height="15"/>
        <textElement/>
        <textFieldExpression><![CDATA["Obra Social: " + $P{healthInsurance}]]></textFieldExpression>
      </textField>
      <staticText>
        <reportElement x="330" y="25" width="100" height="15"/>
        <textElement>
          <font isBold="true"/>
        </textElement>
        <text><![CDATA[Fecha de Emision:]]></text>
      </staticText>
      <textField pattern="dd/MM/yyyy">
        <reportElement x="420" y="25" width="70" height="15"/>
        <textElement textAlignment="Right"/>
        <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
      </textField>
      <staticText>
        <reportElement x="330" y="35" width="100" height="15"/>
        <textElement>
          <font isBold="true"/>
        </textElement>
        <text><![CDATA[Mes a facturar: ]]></text>
      </staticText>
      <textField>
        <reportElement x="420" y="35" width="70" height="15"/>
        <textElement textAlignment="Right"/>
        <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("MMMM yyyy", new java.util.Locale("es", "ES")).format(new java.util.Date())]]></textFieldExpression>
      </textField>
      <line>
        <reportElement x="0" y="50" width="500" height="1"/>
      </line>
    </band>
  </title>

  <!-- 2) Cabecera de columnas -->
  <columnHeader>
    <band height="20">
      <staticText>
        <reportElement x="0"   y="0" width="75" height="20"/>
        <textElement>
          <font isBold="true"/>
        </textElement>
        <text><![CDATA[Paciente]]></text>
      </staticText>
      <staticText>
        <reportElement x="75"   y="0" width="75" height="20"/>
        <textElement>
          <font isBold="true"/>
        </textElement>
        <text><![CDATA[Carnet]]></text>
      </staticText>
      <staticText>
        <reportElement x="150"   y="0" width="75" height="20"/>
        <textElement>
          <font isBold="true"/>
        </textElement>
        <text><![CDATA[Fecha de Realizacion]]></text>
      </staticText>
      <staticText>
        <reportElement x="225" y="0" width="200" height="20"/>
        <textElement>
          <font isBold="true"/>
        </textElement>
        <text><![CDATA[Practicas]]></text>
      </staticText>
      <staticText>
        <reportElement x="450" y="0" width="50" height="20"/>
        <textElement>
          <font isBold="true"/>
        </textElement>
        <text><![CDATA[Sub total]]></text>
      </staticText>
      <!-- Add a horizontal line below the headers -->
      <line>
        <reportElement x="0" y="11" width="500" height="1"/>
      </line>
    </band>
  </columnHeader>

  <!-- 3) Detalle: se repite por cada elemento del JRBeanCollectionDataSource -->
  <detail>
    <band height="18">
      <textField>
        <reportElement x="0" y="0" width="75" height="18"/>
        <textElement>
          <font isBold="false"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{patientName}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="75" y="0" width="75" height="18"/>
        <textElement>
          <font isBold="false"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{patientHealthInsurancePersonalId}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="150" y="0" width="75" height="18"/>
        <textFieldExpression><![CDATA[$F{realizationDate}]]></textFieldExpression>
      </textField>
      <textField pattern="###">
        <reportElement x="225" y="0" width="200" height="18"/>
        <textElement>
          <font isBold="false"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{practiceCodesCsv}]]></textFieldExpression>
      </textField>
      <textField pattern="#,##0.00">
        <reportElement x="450" y="0" width="50" height="18"/>
        <textFieldExpression><![CDATA[$F{subTotal}]]></textFieldExpression>
      </textField>
    </band>
  </detail>

  <!-- 4) Pie de página con total -->
  <pageFooter>
    <band height="30">
      <staticText>
        <reportElement x="280" y="0" width="115" height="15"/>
        <textElement textAlignment="Right">
          <font isBold="true"/>
        </textElement>
        <text><![CDATA[Total:]]></text>
      </staticText>
      <textField pattern="#,##0.00">
        <reportElement x="400" y="0" width="120" height="15"/>
        <textElement textAlignment="Right"/>
        <textFieldExpression><![CDATA[$P{total}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="0" y="15" width="515" height="15"/>
        <textElement textAlignment="Center" verticalAlignment="Bottom">
          <font size="8"/>
        </textElement>
        <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
      </textField>
    </band>
  </pageFooter>
</jasperReport>
